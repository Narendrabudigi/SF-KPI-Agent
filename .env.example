DATABRICKS_HOST=https://your-databricks-instance.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token
DATABRICKS_SQL_HTTP_PATH=/sql/1.0/warehouses/your_sql_warehouse_id

# Polling Intervals
ODATA_POLL_INTERVAL=86400
DATABRICKS_POLL_INTERVAL=15
MAX_WAIT_SECONDS=3600

# Domain Agent Specific Configuration (HR)
RECRUITMENT_NOTEBOOK_PATH=/Workspace/Users/your_user/Agentic_AI/NB_Recruitment_RCA
ONBOARDING_NOTEBOOK_PATH=/Workspace/Users/your_user/Agentic_AI/NB_Onboarding_RCA
OFFBOARDING_NOTEBOOK_PATH=/Workspace/Users/your_user/Agentic_AI/NB_Offboarding_RCA
EMPLOYEE_CENTRAL_NOTEBOOK_PATH=/Workspace/Users/your_user/Agentic_AI/NB_EmployeeCentral_RCA
EMPLOYEE_PAYMENT_NOTEBOOK_PATH=/Workspace/Users/your_user/Agentic_AI/NB_EmployeePayment_RCA

RECRUITMENT_RESULTS_TABLE=workspace.default.recruitment_rca_results
ONBOARDING_RESULTS_TABLE=workspace.default.onboarding_rca_results
OFFBOARDING_RESULTS_TABLE=workspace.default.offboarding_rca_results
EMPLOYEE_CENTRAL_RESULTS_TABLE=workspace.default.employee_central_rca_results
EMPLOYEE_PAYMENT_RESULTS_TABLE=workspace.default.employee_payment_rca_results

# SAP Datasphere OData + OAuth2 Configuration
ODATA_URL=https://your-sap-instance.cloud.sap/api/v1/datasphere/consumption/...
OAUTH_TOKEN_URL=https://your-sap-instance.authentication.us10.hana.ondemand.com/oauth/token
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Google Configuration
GEMINI_API_KEY=your_gemini_api_key

# Groq Configuration
GROQ_API_KEY=your_groq_api_key

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# LLM Fallback Chain
PRIMARY_PROVIDER=gemini
PRIMARY_MODEL=gemini-2.5-flash

SECONDARY_PROVIDER=gemini
SECONDARY_MODEL=gemini-2.5-flash-lite

THIRD_PROVIDER=groq
THIRD_MODEL=llama-3.3-70b-versatile

FOURTH_PROVIDER=groq
FOURTH_MODEL=qwen/qwen3-32b

# Notification & Stakeholder Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=your_email@gmail.com

TA_HEAD_EMAIL=talent_acquisition_head@company.com
HRBP_EMAIL=hr_business_partner@company.com
CHRO_EMAIL=chro@company.com
PAYROLL_MANAGER_EMAIL=payroll_manager@company.com
CFO_EMAIL=cfo@company.com

TEAMS_WEBHOOK_URL=https://your-domain.webhook.office.com/webhookb2/...
